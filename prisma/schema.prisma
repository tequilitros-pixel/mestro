model Branch {
  id               String           @id @default(cuid())
  name             String
  code             String           @unique
  address          String?
  active           Boolean          @default(true)
  /// Color (hex) para identificar la sucursal en la cuadrícula de
  /// Horario. Si no tiene, la UI le asigna uno por defecto.
  color            String?
  /// Zona horaria IANA usada para derivar fechas de negocio locales.
  timezone         String?
  /**
   * Geocerca del checador: si la sucursal tiene una geozona asignada,
   * el checador exige que el empleado esté dentro de ese radio (en
   * metros) para checar entrada o salida. Si no tiene geozona
   * asignada, no se aplica ninguna restricción de ubicación.
   */
  geofenceId       String?
  geofence         Geofence?        @relation(fields: [geofenceId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  counts           InventoryCount[]
  entries          InventoryEntry[]
  timeClockEntries TimeClockEntry[]

  users                         UserBranch[]
  cashCuts                      CashCut[]
  liquorBottles                 LiquorBottle[]
  liquorMovementsFrom           LiquorBottleMovement[]   @relation("LiquorMovementFromBranch")
  liquorMovementsTo             LiquorBottleMovement[]   @relation("LiquorMovementToBranch")
  cashSafeMovements             CashSafeMovement[]
  cashSafeEnvelopes             CashSafeEnvelope[]
  scheduledShifts               ScheduledShift[]
  scheduleTemplates             BranchScheduleTemplate[]
  geofenceAlerts                GeofenceAlert[]
  posSales                      PosSale[]
  posDiscountRules              PosDiscountRule[]
  overtimeRecords               OvertimeRecord[]
  rawMaterialTransfers          RawMaterialMovement[]
  payrollSettings               PayrollSettings?
  scheduleWeekTemplates         ScheduleTemplate[]
  scheduleTemplateShifts        ScheduleTemplateShift[]
  scheduleEvents                ScheduleEvent[]
  workforceAssignments          BranchAssignment[]
  workforceSchedulePeriods      SchedulePeriod[]
  workforceStaffingRequirements StaffingRequirement[]
  workforceShifts               Shift[]
  workforceShiftRevisions       ShiftRevision[]
  workforceClockEvents          ClockEvent[]
  workforceClockCorrections     ClockCorrection[]
  workforceSessions             WorkSession[]
  workforceAttendanceExceptions AttendanceException[]

  eventAddedSource  EventAddedProduct[] @relation("EventAddedSourceBranch")
  eventAddedReturns EventAddedProduct[] @relation("EventAddedReturnBranch")

  @@index([active])
  @@index([geofenceId])
}

/**
 * Geozona: círculo (centro + radio en metros) que puede asignarse a
 * una o varias sucursales para restringir dónde se puede checar
 * entrada/salida. Se administra desde Horario > Geozona.
 */
model Geofence {
  id        String   @id @default(cuid())
  name      String
  latitude  Float
  longitude Float
  radius    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
}

/**
 * Alerta generada cuando un empleado con turno abierto se aleja
 * del radio permitido de su sucursal. Sirve como bitácora para
 * que un administrador la revise (checador > turnos abiertos).
 */
model GeofenceAlert {
  id          String   @id @default(cuid())
  userId      String
  branchId    String
  timeClockId String?
  distance    Int
  createdAt   DateTime @default(now())

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch          @relation(fields: [branchId], references: [id])
  timeClock TimeClockEntry? @relation(fields: [timeClockId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([branchId])
  @@index([createdAt])
}

model UserBranch {
