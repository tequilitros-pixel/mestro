generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                     @id @default(cuid())
  name                      String
  username                  String                     @unique
  email                     String?                    @unique
  /// Teléfono en formato E.164 (ej. +524941234567) para acceso mediante SMS.
  phone                     String?                    @unique
  password                  String
  /// PIN de 4 dígitos (hasheado) para el checador compartido (kiosco):
  /// permite identificarse en una tablet/teléfono común de la sucursal
  /// sin escribir la contraseña completa. Null = no puede usar kiosco.
  pinHash                   String?
  failedLoginAttempts       Int                        @default(0)
  lockedUntil               DateTime?
  role                      UserRole
  active                    Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  lastLogin                 DateTime?
  cookingsFinished          Cooking[]                  @relation("CookingFinishedBy")
  distillationsFinished     Distillation[]             @relation("DistillationFinishedBy")
  fermentationsFinished     Fermentation[]             @relation("FermentationFinishedBy")
  liquorBatchesCreated      LiquorBatch[]              @relation("LiquorBatchCreatedBy")
  liquorBatchesFinished     LiquorBatch[]              @relation("LiquorBatchFinishedBy")
  liquorBottlesSold         LiquorBottle[]             @relation("LiquorBottleSoldBy")
  liquorBottleMovements     LiquorBottleMovement[]     @relation("LiquorBottleMovementCreatedBy")
  liquorBatchsPaused        LiquorBatch[]              @relation("LiquorBatchPausedBy")
  liquorEventsCreated       LiquorBatchEvent[]         @relation("LiquorBatchEventCreatedBy")
  liquorBatchStepsCompleted LiquorBatchStep[]          @relation("LiquorBatchStepCompletedBy")
  liquorBottlingsCreated    LiquorBottling[]           @relation("LiquorBottlingCreatedBy")
  liquorBottlingsFinished   LiquorBottling[]           @relation("LiquorBottlingFinishedBy")
  liquorProductsCreated     LiquorProduct[]            @relation("LiquorProductCreatedBy")
  liquorRecipesCreated      LiquorRecipe[]             @relation("LiquorRecipeCreatedBy")
  lots                      Lot[]
  branches                  UserBranch[]
  cashCutsResponsible       CashCut[]                  @relation("CashCutResponsible")
  cashCutsCreated           CashCut[]                  @relation("CashCutCreatedBy")
  cashCutsUpdated           CashCut[]                  @relation("CashCutUpdatedBy")
  cashOutflowsAuthorized    CashOutflow[]              @relation("CashOutflowAuthorizedBy")
  cashCutAuditEntries       CashCutAuditEntry[]        @relation("CashCutAuditBy")
  cashSafeMovementsBy       CashSafeMovement[]         @relation("CashSafeMovementBy")
  cashSafeEnvelopesCreated  CashSafeEnvelope[]         @relation("CashSafeEnvelopeCreatedBy")
  cashSafeEnvelopesReceived CashSafeEnvelope[]         @relation("CashSafeEnvelopeReceivedBy")
  cashSafeEnvelopeMovements CashSafeEnvelopeMovement[] @relation("CashSafeEnvelopeMovementBy")
  hourlyRate                Decimal?                   @db.Decimal(10, 2)
  timeClockEntries          TimeClockEntry[]           @relation("TimeClockEntries")
  timeClockEntriesClosed    TimeClockEntry[]           @relation("TimeClockClosedBy")
  timeClockEditRequests     TimeClockEditRequest[]     @relation("TimeClockEditRequestedBy")
  timeClockEditReviews      TimeClockEditRequest[]     @relation("TimeClockEditReviewedBy")
  scheduledShifts           ScheduledShift[]           @relation("ScheduledShifts")
  scheduleWeeksPublished    ScheduleWeek[]             @relation("ScheduleWeekPublishedBy")
  geofenceAlerts            GeofenceAlert[]
  salaryRates               SalaryRate[]               @relation("SalaryRateOwner")
  salaryRatesCreated        SalaryRate[]               @relation("SalaryRateCreatedBy")

  millingsFinished   Milling[]           @relation("MillingFinishedBy")
  millingDischarges  MillingDischarge[]
  pushSubscriptions  PushSubscription[]
  passwordResetCodes PasswordResetCode[]
  modulePermissions  ModulePermission[]
  sessions           UserSession[]

  posCategoriesCreated     PosCategory[]      @relation("PosCategoryCreatedBy")
  posProductsCreated       PosProduct[]       @relation("PosProductCreatedBy")
  posSalesSold             PosSale[]          @relation("PosSaleSoldBy")
  posSalesCancelled        PosSale[]          @relation("PosSaleCancelledBy")
  posSalesAsEmployeeBuyer  PosSale[]          @relation("PosSaleEmployeeBuyer")
  posSalesAuthorized       PosSale[]          @relation("PosSaleAuthorizedBy")
  posSaleItemsBeneficiary  PosSaleItem[]      @relation("PosSaleItemBeneficiary")
  posSaleItemsAuthorized   PosSaleItem[]      @relation("PosSaleItemAuthorizedBy")
  posDiscountLimitsUpdated PosDiscountLimit[] @relation("PosDiscountLimitUpdatedBy")
  posDiscountRulesCreated  PosDiscountRule[]  @relation("PosDiscountRuleCreatedBy")
  posDiscountRulesUpdated  PosDiscountRule[]  @relation("PosDiscountRuleUpdatedBy")
  posSettingsUpdated       PosSettings[]      @relation("PosSettingsUpdatedBy")

  overtimeRecords         OvertimeRecord[]      @relation("OvertimeWorker")
  overtimeRecordsReviewed OvertimeRecord[]      @relation("OvertimeReviewedBy")
  rawMaterialMovements    RawMaterialMovement[] @relation("RawMaterialMovementBy")

  payrollAdjustments        PayrollAdjustment[] @relation("PayrollAdjustmentOwner")
  payrollAdjustmentsCreated PayrollAdjustment[] @relation("PayrollAdjustmentCreatedBy")

  payrollPeriodsSubmitted PayrollPeriod[] @relation("PayrollPeriodSubmittedBy")
  payrollPeriodsApproved  PayrollPeriod[] @relation("PayrollPeriodApprovedBy")
  payrollPeriodsPaid      PayrollPeriod[] @relation("PayrollPeriodPaidBy")
  payrollEntries          PayrollEntry[]  @relation("PayrollEntryOwner")

  payrollIncidentJustifications   PayrollIncidentJustification[] @relation("PayrollIncidentJustificationOwner")
  payrollIncidentJustificationsBy PayrollIncidentJustification[] @relation("PayrollIncidentJustificationBy")

  scheduleTemplatesCreated    ScheduleTemplate[]              @relation("ScheduleTemplateCreatedBy")
  scheduleTemplateShifts      ScheduleTemplateShift[]         @relation("ScheduleTemplateShiftOwner")
  scheduleEventsCreated       ScheduleEvent[]                 @relation("ScheduleEventCreatedBy")
  availabilityRules           EmployeeAvailabilityRule[]
  availabilityExceptions      EmployeeAvailabilityException[]
  availabilitySettingsUpdated AvailabilitySettings[]          @relation("AvailabilitySettingsUpdatedBy")
  availabilityOverrides       AvailabilityOverrideAudit[]     @relation("AvailabilityOverrideEmployee")
  availabilityOverridesBy     AvailabilityOverrideAudit[]     @relation("AvailabilityOverrideBy")
  shiftRequests               ShiftChangeRequest[]            @relation("ShiftRequestOwner")
  shiftRequestsAsSwapTarget   ShiftChangeRequest[]            @relation("ShiftRequestSwapTarget")
  shiftRequestsReviewed       ShiftChangeRequest[]            @relation("ShiftRequestReviewedBy")

  eventAddedProducts  EventAddedProduct[]    @relation("EventAddedBy")
  eventAddedCancelled EventAddedProduct[]    @relation("EventAddedCancelledBy")
  eventAddedLogs      EventAddedProductLog[] @relation("EventAddedLogBy")

  workforceEmployee                     Employee?
  workforceSchedulePeriodsCreated       SchedulePeriod[]             @relation("WorkforceSchedulePeriodCreatedBy")
  workforceShiftsCreated                Shift[]                      @relation("WorkforceShiftCreatedBy")
  workforceShiftRevisionsChanged        ShiftRevision[]              @relation("WorkforceShiftRevisionChangedBy")
  workforceSchedulePublications         SchedulePublication[]        @relation("WorkforceSchedulePublicationPublishedBy")
  workforceStaffingRequirementsCreated  StaffingRequirement[]        @relation("WorkforceStaffingRequirementCreatedBy")
  workforceClockCorrectionsRequested    ClockCorrection[]            @relation("WorkforceClockCorrectionRequestedBy")
  workforceClockCorrectionsApproved     ClockCorrection[]            @relation("WorkforceClockCorrectionApprovedBy")
  workforceClockCorrectionsRejected     ClockCorrection[]            @relation("WorkforceClockCorrectionRejectedBy")
  workforceAttendanceExceptionsResolved AttendanceException[]        @relation("WorkforceAttendanceExceptionResolvedBy")
  workforceTimesheetsApproved           Timesheet[]                  @relation("WorkforceTimesheetApprovedBy")
  workforceTimesheetAdjustmentsCreated  TimesheetAdjustment[]        @relation("WorkforceTimesheetAdjustmentCreatedBy")
  workforceTimesheetAdjustmentsApproved TimesheetAdjustment[]        @relation("WorkforceTimesheetAdjustmentApprovedBy")
  workforcePayrollAdjustmentsCreated    WorkforcePayrollAdjustment[] @relation("WorkforcePayrollAdjustmentCreatedBy")
  workforcePayrollAdjustmentsApproved   WorkforcePayrollAdjustment[] @relation("WorkforcePayrollAdjustmentApprovedBy")
}

model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuthThrottle {
  key          String    @id
  attempts     Int       @default(0)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([blockedUntil])
}

model Equipment {
  id                String             @id @default(cuid())
  name              String
  type              EquipmentType
  status            EquipmentStatus    @default(DISPONIBLE)
  capacity          Float
  currentLoad       Float              @default(0)
  unit              String
  location          String?
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cookings          Cooking[]
  distillations     Distillation[]
  millings          Milling[]
  millingDischarges MillingDischarge[]
}

model Lot {
  id                  String                @id @default(cuid())
  code                String                @unique
  stage               LotStage
  agaveKg             Float
  art                 Float?
  startedAt           DateTime
  finishedAt          DateTime?
  totalLitersObtained Float?
  qrToken             String?               @unique
  observations        String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  ownerId             String
  cookings            Cooking[]
  distillations       Distillation[]
  fermentations       Fermentation[]
  owner               User                  @relation(fields: [ownerId], references: [id])
  expenses            LotExpense[]
  millings            Milling[]
  liquorBatches       LiquorBatch[]
  rawMaterialEntries  RawMaterialMovement[]
}

model Cooking {
  id                    String         @id @default(cuid())
  lotId                 String
  equipmentId           String
  agaveKg               Float
  status                CookingStatus  @default(ACTIVA)
  startedAt             DateTime       @default(now())
  finishedAt            DateTime?
  notes                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  closureCode           String?        @unique
  finalAgaveKg          Float?
  finalNotes            String?
  finalSweetHoneyBrix   Float?
  finalSweetHoneyLiters Float?
  finishedById          String?
  equipment             Equipment      @relation(fields: [equipmentId], references: [id])
  finishedBy            User?          @relation("CookingFinishedBy", fields: [finishedById], references: [id])
  lot                   Lot            @relation(fields: [lotId], references: [id])
  events                CookingEvent[]

  @@index([lotId])
  @@index([equipmentId])
  @@index([finishedById])
}

model CookingEvent {
  id                String           @id @default(cuid())
  cookingId         String
  type              CookingEventType
  temperatureTop    Float?
  temperatureMiddle Float?
  temperatureBottom Float?
  liters            Float?
  ph                Float?
  brix              Float?
  temperature       Float?
  notes             String?
  createdAt         DateTime         @default(now())
  cooking           Cooking          @relation(fields: [cookingId], references: [id])

  @@index([cookingId])
}

model Milling {
  id                  String             @id @default(cuid())
  lotId               String
  equipmentId         String
  status              MillingStatus      @default(ACTIVA)
  operator            String?
  cookedKg            Float
  waterLiters         Float?
  mashLiters          Float?
  bagasseKg           Float?
  brix                Float?
  ph                  Float?
  temperature         Float?
  pressPasses         Int?
  washBagasse         Boolean            @default(false)
  washRecoveredLiters Float?
  observations        String?
  startedAt           DateTime           @default(now())
  finishedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  closureCode         String?            @unique
  finalAverageBrix    Float?
  finalAveragePh      Float?
  finalAverageTemp    Float?
  finalBagasseKg      Float?
  finalMashLiters     Float?
  finalNotes          String?
  finalPressPasses    Int?
  finalWaterLiters    Float?
  finishedById        String?
  equipment           Equipment          @relation(fields: [equipmentId], references: [id])
  finishedBy          User?              @relation("MillingFinishedBy", fields: [finishedById], references: [id])
  lot                 Lot                @relation(fields: [lotId], references: [id])
  discharges          MillingDischarge[]
  events              MillingEvent[]

  @@index([lotId])
  @@index([equipmentId])
  @@index([finishedById])
}

model MillingEvent {
  id                  String           @id @default(cuid())
  millingId           String
  type                MillingEventType
  value               Float?
  brix                Float?
  ph                  Float?
  temperature         Float?
  waterLiters         Float?
  bagasseKg           Float?
  washRecoveredLiters Float?
  pressPasses         Int?
  notes               String?
  createdAt           DateTime         @default(now())
  milling             Milling          @relation(fields: [millingId], references: [id])

  @@index([millingId])
}

model Fermentation {
  id                 String                @id @default(cuid())
  lotId              String
  tank               String
  mustLiters         Float
  initialBrix        Float
  initialPh          Float
  initialTemperature Float
  yeast              String?
  inoculatedAt       DateTime
  status             FermentationStatus    @default(ACTIVA)
  startedAt          DateTime              @default(now())
  finishedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  closureCode        String?               @unique
  finalAlcohol       Float?
  finalBrix          Float?
  finalNotes         String?
  finalPh            Float?
  finishedById       String?
  finishedBy         User?                 @relation("FermentationFinishedBy", fields: [finishedById], references: [id])
  lot                Lot                   @relation(fields: [lotId], references: [id])
  readings           FermentationReading[]

  @@index([lotId])
  @@index([finishedById])
}

model FermentationReading {
  id               String       @id @default(cuid())
  fermentationId   String
  brix             Float?
  ph               Float?
  temperature      Float?
  alcohol          Float?
  saccharometer    Float?
  citricAcidGrams  Float?
  bicarbonateGrams Float?
  heated           Boolean      @default(false)
  heatingMinutes   Int?
  notes            String?
  createdAt        DateTime     @default(now())
  fermentation     Fermentation @relation(fields: [fermentationId], references: [id])

  @@index([fermentationId])
}

model Distillation {
  id               String              @id @default(cuid())
  lotId            String
  equipmentId      String
  type             DistillationType
  loadedLiters     Float
  initialAlcohol   Float?
  headsLiters      Float?
  heartLiters      Float?
  tailsLiters      Float?
  finalAlcohol     Float?
  status           DistillationStatus  @default(ACTIVA)
  startedAt        DateTime            @default(now())
  finishedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  closureCode      String?             @unique
  finalHeadsLiters Float?
  finalHeartLiters Float?
  finalLiters      Float?
  finalNotes       String?
  finalTailsLiters Float?
  finishedById     String?
  equipment        Equipment           @relation(fields: [equipmentId], references: [id])
  finishedBy       User?               @relation("DistillationFinishedBy", fields: [finishedById], references: [id])
  lot              Lot                 @relation(fields: [lotId], references: [id])
  events           DistillationEvent[]

  @@index([lotId])
  @@index([equipmentId])
  @@index([finishedById])
}

model DistillationEvent {
  id                String                @id @default(cuid())
  distillationId    String
  type              DistillationEventType
  temperature       Float?
  alcohol           Float?
  liters            Float?
  outputTemperature Float?
  alcoholCorrected  Float?
  notes             String?
  createdAt         DateTime              @default(now())
  distillation      Distillation          @relation(fields: [distillationId], references: [id])

  @@index([distillationId])
}

model LotExpense {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  lotId     String
  category  String
  concept   String
  amount    Float
  notes     String?
  lot       Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId])
}

model MillingDischarge {
  id              String     @id @default(cuid())
  millingId       String
  tankId          String?
  litersRecovered Float
  brix            Float
  ph              Float
  temperature     Float
  notes           String?
  createdById     String?
  createdAt       DateTime   @default(now())
  createdBy       User?      @relation(fields: [createdById], references: [id])
  milling         Milling    @relation(fields: [millingId], references: [id], onDelete: Cascade)
  tank            Equipment? @relation(fields: [tankId], references: [id])

  @@index([millingId])
  @@index([tankId])
  @@index([createdById])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RawMaterial {
  id String @id @default(cuid())

  code String @unique
  name String @unique

  category    String?
  description String?

  baseUnit String

  currentStock Float @default(0)
  minimumStock Float @default(0)

  averageCost Float?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Marca el material que recibe automáticamente el destilado de los
  /// lotes de agave al cerrarlos. Solo uno debe tenerlo en true.
  receivesLotOutput Boolean @default(false)

  /**
   * Configuración de embotellado.
   * El tequila blanco NO es un licor que se elabore con receta: sale
   * del proceso de agave y solo se embotella o se traspasa. Por eso
   * los datos de etiquetado viven aquí y no en LiquorProduct, para
   * mantenerlo fuera del catálogo de licores.
   */
  /// Habilita embotellar directamente desde esta existencia a granel.
  bottleable            Boolean @default(false)
  /// Prefijo de los folios de botella (ej. "TQB").
  bottlePrefix          String?
  /// Vida útil en días que se imprime y se usa para las alertas.
  defaultShelfLifeDays  Int?
  yellowAlertDays       Int?
  redAlertDays          Int?
  showExpirationOnLabel Boolean @default(true)

  /// Producto de inventario equivalente, para abonar el stock de
  /// sucursal al traspasar o al embotellar.
  inventoryProductId String?
  inventoryProduct   InventoryProduct? @relation("RawMaterialInventoryLink", fields: [inventoryProductId], references: [id])

  recipeIngredients LiquorRecipeIngredient[]
  movements         RawMaterialMovement[]
  bottlings         LiquorBottling[]

  @@index([active])
  @@index([category])
}

/// *
///  * Movimientos de materia prima del almacén de producción.
///  *
///  * `RawMaterial.currentStock` es el acumulado de estos movimientos:
///  * las entradas van en positivo (compra, producción de un lote,
///  * devolución) y las salidas en negativo (consumo de receta, merma,
///  * traspaso a sucursal). Nunca se edita el stock a mano — siempre se
///  * registra un movimiento, para que exista rastro de por qué cambió.
model RawMaterialMovement {
  id            String @id @default(cuid())
  rawMaterialId String

  type     RawMaterialMovementType
  /// Positiva en entradas, negativa en salidas.
  quantity Float
  /// Costo unitario de la entrada; alimenta el costo promedio.
  unitCost Float?

  /// Lote de agave que originó el movimiento (entradas de producción).
  lotId         String?
  /// Elaboración de licor que consumió el material.
  liquorBatchId String?
  /// Sucursal destino cuando el movimiento es un traspaso.
  branchId      String?

  notes       String?
  createdById String?

  createdAt DateTime @default(now())

  rawMaterial RawMaterial  @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  lot         Lot?         @relation(fields: [lotId], references: [id])
  liquorBatch LiquorBatch? @relation(fields: [liquorBatchId], references: [id])
  branch      Branch?      @relation(fields: [branchId], references: [id])
  createdBy   User?        @relation("RawMaterialMovementBy", fields: [createdById], references: [id])

  @@index([rawMaterialId])
  @@index([type])
  @@index([createdAt])
  @@index([lotId])
  @@index([liquorBatchId])
  @@index([branchId])
}

enum RawMaterialMovementType {
  /// Entrada por compra a proveedor.
  COMPRA
  /// Entrada por destilado propio al cerrar un lote de agave.
  PRODUCCION
  /// Salida al agregar el ingrediente durante una elaboración.
  CONSUMO_RECETA
  /// Corrección manual de existencia (positiva o negativa).
  AJUSTE
  /// Salida por pérdida, derrame o producto no utilizable.
  MERMA
  /// Salida por envío a una sucursal.
  TRASPASO_SUCURSAL
}

model LiquorProduct {
  id             String  @id @default(cuid())
  name           String  @unique
  slug           String  @unique
  prefix         String  @unique
  description    String?
  icon           String?
  defaultAlcohol Float?

  // Configuración de caducidad
  defaultShelfLifeDays  Int?
  yellowAlertDays       Int     @default(30)
  redAlertDays          Int     @default(7)
  showExpirationOnLabel Boolean @default(true)

  // Configuración de trazabilidad
  requiresQr           Boolean @default(true)
  requiresSerialNumber Boolean @default(true)

  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batches   LiquorBatch[]
  createdBy User?          @relation("LiquorProductCreatedBy", fields: [createdById], references: [id])
  recipes   LiquorRecipe[]

  // Producto terminado equivalente en el inventario de sucursales:
  // al terminar un embotellado se abonan las botellas creadas a esta
  // ficha (ver createLiquorBottlingAction). Opcional porque no todos
  // los productos de licores tienen todavía su contraparte de
  // inventario configurada.
  inventoryProductId String?           @unique
  inventoryProduct   InventoryProduct? @relation(fields: [inventoryProductId], references: [id])

  @@index([createdById])
  @@index([active])
}

/// *
///  * Una misma clase de licor puede tener varias versiones de receta.
///  * Ejemplo:
///  * Zarzamora V1
///  * Zarzamora V2
///  * Zarzamora V3
///  * Los lotes anteriores conservan la receta que utilizaron.
model LiquorRecipe {
  id            String                   @id @default(cuid())
  productId     String
  name          String
  version       Int
  targetLiters  Float?
  targetAlcohol Float?
  instructions  String?
  notes         String?
  active        Boolean                  @default(true)
  createdById   String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  batches       LiquorBatch[]
  createdBy     User?                    @relation("LiquorRecipeCreatedBy", fields: [createdById], references: [id])
  product       LiquorProduct            @relation(fields: [productId], references: [id])
  ingredients   LiquorRecipeIngredient[]
  steps         LiquorRecipeStep[]

  @@unique([productId, version])
  @@index([productId])
  @@index([createdById])
  @@index([active])
}

model LiquorRecipeStep {
  id                 String                  @id @default(cuid())
  recipeId           String
  position           Int
  type               LiquorStepType
  title              String
  instruction        String?
  actions            String[]
  checks             String[]
  recipeIngredientId String?
  durationMinutes    Int?
  minimumMinutes     Int?
  maximumMinutes     Int?
  measurementLabel   String?
  measurementUnit    String?
  minimumValue       Float?
  maximumValue       Float?
  required           Boolean                 @default(true)
  active             Boolean                 @default(true)
  notes              String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  batchSteps         LiquorBatchStep[]
  recipe             LiquorRecipe            @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeIngredient   LiquorRecipeIngredient? @relation(fields: [recipeIngredientId], references: [id])

  @@unique([recipeId, position])
  @@index([recipeId])
  @@index([recipeIngredientId])
  @@index([type])
}

/// *
///  * Ingredientes oficiales de cada versión de receta.
model LiquorRecipeIngredient {
  id String @id @default(cuid())

  recipeId String
  recipe   LiquorRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  name String

  rawMaterialId String?
  rawMaterial   RawMaterial? @relation(fields: [rawMaterialId], references: [id], onDelete: SetNull)

  quantity Float
  unit     String

  position Int     @default(0)
  optional Boolean @default(false)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batchIngredients LiquorBatchIngredient[]
  recipeSteps      LiquorRecipeStep[]

  @@index([recipeId])
  @@index([rawMaterialId])
  @@index([position])
}

/// *
///  * Cada elaboración física de un licor.
///  * El campo sequence mantiene el consecutivo permanente global:
///  * LZ-15-07-2026-001
///  * LM-16-07-2026-002
///  * LC-18-07-2026-003
model LiquorBatch {
  id             String              @id @default(cuid())
  code           String              @unique
  sequence       Int                 @unique
  productId      String
  recipeId       String
  status         LiquorBatchStatus   @default(PLANEADO)
  plannedLiters  Float
  actualLiters   Float?
  initialAlcohol Float?
  finalAlcohol   Float?
  productionDate DateTime            @default(now())
  expirationDate DateTime?
  qualityStatus  LiquorQualityStatus @default(PENDIENTE)
  startedAt      DateTime?
  finishedAt     DateTime?
  closureCode    String?             @unique
