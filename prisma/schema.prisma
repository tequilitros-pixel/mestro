  // `code` queda temporalmente nullable para un despliegue compatible;
  // el código nuevo escribe y verifica exclusivamente `codeHash`.
  code      String?
  codeHash  String?
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
