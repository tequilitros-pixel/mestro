  steps                LiquorBatchStep[]
  bottlings            LiquorBottling[]
  rawMaterialMovements RawMaterialMovement[]

  @@index([productId])
  @@index([recipeId])
  @@index([status])
  @@index([qualityStatus])
  @@index([productionDate])
  @@index([createdById])
  @@index([finishedById])
  @@index([lotId])
}

