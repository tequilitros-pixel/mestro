  events ServiceEvent[]
}

model EquipmentKitItem {
  id         String  @id @default(cuid())
  kitId      String
  productId  String
  quantity   Decimal @db.Decimal(12, 3)
  isRequired Boolean @default(true)
  notes      String?
  sortOrder  Int     @default(0)

  kit     EquipmentKit     @relation(fields: [kitId], references: [id], onDelete: Cascade)
  product InventoryProduct @relation(fields: [productId], references: [id])

  @@unique([kitId, productId])
}

enum InventoryEntryType {
  COMPRA
  TRASPASO
  AJUSTE
  // Descuento/reversión automática por una venta del Punto de Venta.
  // Se suman igual que cualquier otra entrada en computeStockMatrix,
  // así que el stock por sucursal queda correcto sin tocar ese cálculo.
  VENTA_POS
  DEVOLUCION_POS
  // Salida automática al abrir un corte de caja vinculado a un
  // evento: descuenta lo cargado (ServiceEventItem) del inventario
  // de la sucursal donde se abre el corte.
  SALIDA_EVENTO
  // Regreso de producto que se habia enviado a un evento. Contraparte
  // de SALIDA_EVENTO: reingresa a la sucursal lo que no se consumio.
  REGRESO_EVENTO
  // Entrada automática al terminar un embotellado (createLiquorBottlingAction):
  // abona las botellas recién creadas a la sucursal de resguardo del
  // producto terminado (LiquorProduct.inventoryProductId).
  PRODUCCION
}

model InventoryEntry {
  id               String                 @id @default(cuid())
  branchId         String
  productId        String
  type             InventoryEntryType
  quantity         Decimal                @db.Decimal(12, 3)
  unitCost         Decimal?               @db.Decimal(12, 4)
  originalQuantity Decimal?               @db.Decimal(12, 3)
  originalUnit     String?
  handlingUnit     InventoryHandlingUnit?
  contentPerUnit   Decimal?               @db.Decimal(12, 3)
  contentUnit      InventoryContentUnit?
  entryDate        DateTime               @default(now())
  notes            String?
  createdAt        DateTime               @default(now())

  branch  Branch           @relation(fields: [branchId], references: [id])
  product InventoryProduct @relation(fields: [productId], references: [id])

  @@index([branchId])
  @@index([productId])
  @@index([entryDate])
}

enum InventoryCountStatus {
  BORRADOR
  CERRADO
}

model InventoryCount {
