  description    String?
  pricePerPerson Decimal? @db.Decimal(10, 2)
  includedHours  Int?
  minimumGuests  Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

