  countId          String
  productId        String
  quantityCounted  Decimal  @db.Decimal(12, 3)
  previousQuantity Decimal? @db.Decimal(12, 3)
  entriesQuantity  Decimal  @default(0) @db.Decimal(12, 3)
  quantityConsumed Decimal? @db.Decimal(12, 3)
