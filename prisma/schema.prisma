model TimeClockEntry {
  id                  String    @id @default(cuid())
  userId              String
  branchId            String
  clockIn             DateTime
  clockOut            DateTime?
  confirmedByEmployee Boolean   @default(false)
  closedManuallyById  String?
  notes               String?
  createdAt           DateTime  @default(now())

  /// De dónde salió el registro: CHECADOR = el empleado checó él mismo
  /// (o se editó/cerró desde ese flujo); MANUAL = un admin/gerente lo
  /// creó directamente (p. ej. alguien olvidó checar por completo).
  source TimeClockSource @default(CHECADOR)

  /// Turno programado con el que coincide esta checada, si se pudo
  /// emparejar automáticamente al checar entrada. Permite comparar
  /// PROGRAMADO vs REAL con precisión aunque la persona tenga más de
  /// un turno el mismo día. Puede quedar nulo (checó sin turno
  /// programado, o el emparejamiento automático no encontró uno).
  scheduledShiftId String?

  user             User                   @relation("TimeClockEntries", fields: [userId], references: [id])
  branch           Branch                 @relation(fields: [branchId], references: [id])
  closedManuallyBy User?                  @relation("TimeClockClosedBy", fields: [closedManuallyById], references: [id])
  scheduledShift   ScheduledShift?        @relation(fields: [scheduledShiftId], references: [id], onDelete: SetNull)
  geofenceAlerts   GeofenceAlert[]
  editRequests     TimeClockEditRequest[]

  @@index([userId])
  @@index([branchId])
  @@index([clockIn])
  @@index([scheduledShiftId])
}

enum TimeClockSource {
  CHECADOR
  MANUAL
}

/**
 * Solicitud del empleado para corregir las horas de un turno ya
 * cerrado en el checador. No se aplica de inmediato: queda
 * pendiente hasta que un administrador la aprueba o la rechaza
 * (checador > turnos abiertos > solicitudes de edición).
 */
model TimeClockEditRequest {
  id          String @id @default(cuid())
  timeClockId String
  userId      String

  /// Horas originales del turno al momento de crear la solicitud
  /// (para poder mostrar "antes / después" aunque el turno cambie).
  originalClockIn  DateTime
  originalClockOut DateTime?

  requestedClockIn  DateTime
  requestedClockOut DateTime
  reason            String?

  status TimeClockEditStatus @default(PENDIENTE)

  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?

  createdAt DateTime @default(now())

  timeClock  TimeClockEntry @relation(fields: [timeClockId], references: [id], onDelete: Cascade)
  user       User           @relation("TimeClockEditRequestedBy", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?          @relation("TimeClockEditReviewedBy", fields: [reviewedById], references: [id])

  @@index([timeClockId])
  @@index([userId])
  @@index([status])
}

enum TimeClockEditStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model ScheduledShift {
  id       String   @id @default(cuid())
  userId   String
  /// Nulo cuando type = DESCANSO (día libre, no tiene sucursal).
  branchId String?
  date     DateTime

  /// TURNO = turno normal de trabajo. DESCANSO = día libre, sin
  /// sucursal ni horas.
  type ShiftType @default(TURNO)

  /// Nulos cuando type = DESCANSO.
  startTime String?
  endTime   String?

  /// Puesto/función de este turno (texto libre), ej. "Bartender".
  position String?

  notes String?

  /// Si este turno es la asignación de un empleado a un evento puntual
  /// (boda, XV años, feria, etc.), apunta al ScheduleEvent que trae el
  /// nombre/descripción/ubicación/instrucciones compartidos por todos
  /// los empleados asignados. Nulo = turno normal, sin evento.
  eventId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                  User                        @relation("ScheduledShifts", fields: [userId], references: [id], onDelete: Cascade)
  branch                Branch?                     @relation(fields: [branchId], references: [id])
  event                 ScheduleEvent?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  timeClockEntries      TimeClockEntry[]
  availabilityOverrides AvailabilityOverrideAudit[]
  changeRequests        ShiftChangeRequest[]

  @@index([userId])
  @@index([branchId])
  @@index([date])
  @@index([eventId])
}

model AvailabilityOverrideAudit {
  id                   String   @id @default(cuid())
  shiftId              String
  userId               String
  overriddenById       String
  availabilitySnapshot Json
  reason               String?
  createdAt            DateTime @default(now())

  shift        ScheduledShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user         User           @relation("AvailabilityOverrideEmployee", fields: [userId], references: [id], onDelete: Cascade)
  overriddenBy User           @relation("AvailabilityOverrideBy", fields: [overriddenById], references: [id])

  @@index([shiftId])
  @@index([userId, createdAt])
}

enum ShiftChangeRequestType {
  CANNOT_WORK
  CHANGE_TIME
  SWAP
  DAY_OFF
}

enum ShiftChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ShiftChangeRequest {
  id                String                   @id @default(cuid())
  shiftId           String
  requestedById     String
  type              ShiftChangeRequestType
  proposedStartTime String?
  proposedEndTime   String?
  swapTargetUserId  String?
  reason            String
  status            ShiftChangeRequestStatus @default(PENDING)
  reviewedById      String?
  reviewedAt        DateTime?
  reviewNotes       String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  shift          ScheduledShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  requestedBy    User           @relation("ShiftRequestOwner", fields: [requestedById], references: [id], onDelete: Cascade)
  swapTargetUser User?          @relation("ShiftRequestSwapTarget", fields: [swapTargetUserId], references: [id])
  reviewedBy     User?          @relation("ShiftRequestReviewedBy", fields: [reviewedById], references: [id])

  @@index([requestedById, status])
  @@index([shiftId, status])
  @@index([status, createdAt])
}

enum ShiftType {
  TURNO
  DESCANSO
}

/**
 * Historial de sueldo por empleado. Cambiar el sueldo hoy crea un
 * registro nuevo con `effectiveFrom` desde hoy; los anteriores se
 * cierran con `effectiveTo`. Así, calcular la nómina de una semana
 * pasada usa la tarifa que estaba vigente ENTONCES, no la actual.
 * `User.hourlyRate` se mantiene como caché de la tarifa HORA vigente
 * (lo sigue usando el checador y el dashboard de nómina actual) y se
 * sincroniza automáticamente cada vez que se registra una tarifa
 * nueva de tipo HORA.
 */
model SalaryRate {
  id     String           @id @default(cuid())
  userId String
  scheme SalarySchemeType @default(HORA)

  /// Monto según el esquema: tarifa por hora, sueldo diario o sueldo
  /// semanal — la unidad la da `scheme`, no hay tres campos sueltos.
  amount Decimal @db.Decimal(10, 2)

  effectiveFrom DateTime
  /// Nulo = es la tarifa vigente actualmente.
  effectiveTo   DateTime?

  createdById String?
  notes       String?
  createdAt   DateTime @default(now())

  user      User  @relation("SalaryRateOwner", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("SalaryRateCreatedBy", fields: [createdById], references: [id])

  @@index([userId, effectiveFrom])
}

enum SalarySchemeType {
  HORA
  DIA
  SEMANA
}

/**
 * Estado de publicación del horario semanal (una fila por semana,
 * global para toda la empresa). Mientras está en DRAFT, solo los
 * administradores lo ven en la cuadrícula de Horario. Al publicarlo,
 * los empleados empiezan a verlo en su calendario (/timeclock/calendar).
 */
model ScheduleWeek {
  id        String             @id @default(cuid())
  weekStart DateTime           @unique
  status    ScheduleWeekStatus @default(DRAFT)

  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?     @relation("ScheduleWeekPublishedBy", fields: [publishedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum ScheduleWeekStatus {
  DRAFT
  PUBLISHED
}

enum AvailabilityType {
  AVAILABLE_ALL_DAY
  AVAILABLE_PARTIAL
  UNAVAILABLE
  PREFER_OFF
}

enum AvailabilityReason {
  MEDICAL
  SCHOOL
  FAMILY
  TRAVEL
  ERRAND
  OTHER
}

/// Regla semanal recurrente. dayOfWeek usa lunes=0…domingo=6.
model EmployeeAvailabilityRule {
  id          String              @id @default(cuid())
  userId      String
  dayOfWeek   Int
  type        AvailabilityType
  startTime   String?
  endTime     String?
  reason      AvailabilityReason?
  reasonNotes String?
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek])
  @@index([userId])
}

/// Excepción para una fecha concreta; siempre tiene prioridad sobre la regla recurrente.
model EmployeeAvailabilityException {
  id          String              @id @default(cuid())
  userId      String
  date        DateTime
  type        AvailabilityType
  startTime   String?
  endTime     String?
  reason      AvailabilityReason?
  reasonNotes String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

/// Regla global de cierre para capturar la disponibilidad de la semana siguiente.
model AvailabilitySettings {
  id              String   @id @default("default")
  deadlineWeekday Int      @default(3)
  deadlineTime    String   @default("18:00")
  weeksAhead      Int      @default(1)
  timezone        String   @default("America/Mexico_City")
  updatedById     String?
  updatedAt       DateTime @updatedAt

  updatedBy User? @relation("AvailabilitySettingsUpdatedBy", fields: [updatedById], references: [id])
}

/**
 * Plantilla de horario por sucursal.
 * Define el horario estándar (entrada/salida) de una sucursal
 * para cada día de la semana (0 = lunes ... 6 = domingo, igual
 * que en ScheduleBuilder). Se usa para autocompletar horas al
 * agregar un turno y así no capturarlas a mano cada vez.
 */
model BranchScheduleTemplate {
  id        String   @id @default(cuid())
  branchId  String
  dayOfWeek Int
  startTime String
  endTime   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
  @@index([branchId])
}

/**
 * Plantilla de SEMANA completa y reutilizable (distinta de
 * BranchScheduleTemplate, que solo es el horario estándar por día).
 * Guarda una "foto" de lunes a domingo: qué empleado trabaja qué día,
 * en qué sucursal, con qué horario y puesto. Es independiente de la
 * semana real de la que se creó — modificar esa semana después NO
 * cambia la plantilla, porque ScheduleTemplateShift no tiene relación
 * de vuelta a ScheduledShift, solo copia sus valores.
 */
model ScheduleTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?

  /// Sucursal principal de la plantilla, solo informativo/filtro (los
  /// turnos dentro de la plantilla pueden tener su propia sucursal).
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdById String?
  createdBy   User?   @relation("ScheduleTemplateCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts ScheduleTemplateShift[]

  @@index([branchId])
}

/// Un turno dentro de una ScheduleTemplate. `dayOfWeek` es relativo
/// (0 = lunes ... 6 = domingo, igual que BranchScheduleTemplate) en
/// vez de una fecha absoluta, para poder aplicarse a cualquier semana.
model ScheduleTemplateShift {
  id         String @id @default(cuid())
  templateId String

  dayOfWeek Int

  /// Nulo = "sin asignar todavía"; se puede completar al aplicar la
  /// plantilla (sustitución de empleados) o quedar pendiente.
  userId String?

  branchId String?
  type     ShiftType @default(TURNO)

  startTime String?
  endTime   String?
  position  String?
  notes     String?

  template ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User?            @relation("ScheduleTemplateShiftOwner", fields: [userId], references: [id], onDelete: SetNull)
  branch   Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@index([userId])
  @@index([branchId])
}

/**
 * Evento puntual (boda, XV años, feria, servicio de barra, etc.): un
 * trabajo real en una fecha determinada, distinto de una plantilla
 * reutilizable. La info (nombre, descripción, ubicación, instrucciones)
 * vive UNA sola vez aquí; cada empleado asignado tiene su propio
 * ScheduledShift (con este id en `eventId`), así que el checador y la
 * nómina siguen viendo turnos normales sin ningún cambio.
 * Un evento nunca se convierte automáticamente en plantilla — eso
 * requiere la acción explícita "Guardar como plantilla" sobre la
 * semana, que además ignora los turnos que tengan eventId.
 */
model ScheduleEvent {
  id          String  @id @default(cuid())
  name        String
  description String?

  date      DateTime
  startTime String
  endTime   String

  location String?

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  position String?

  /// Instrucciones para el personal (visibles también al empleado).
  instructions  String?
  /// Notas internas, solo para administración.
  internalNotes String?

  createdById String?
  createdBy   User?   @relation("ScheduleEventCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts ScheduledShift[]

  @@index([date])
  @@index([branchId])
}

/// *
///  * Tiempo extra.
///  *
///  * El sistema DETECTA solo las horas extra comparando lo checado
///  * (TimeClockEntry) contra el umbral semanal configurado, pero NO las
///  * cuenta como costo hasta que un administrador las aprueba. Por eso
///  * cada registro nace en estado PENDIENTE.
///  *
///  * Se guarda un registro por persona + sucursal + semana. Los montos
///  * (`amount`) y la tarifa (`hourlyRate`) se congelan al momento de
///  * aprobar, para que un cambio posterior de sueldo no altere una
///  * nómina ya autorizada.
model OvertimeRecord {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  /// Lunes de la semana a la que corresponde el tiempo extra.
  weekStart DateTime

  /// Horas trabajadas en la semana por encima del umbral configurado.
  overtimeHours Decimal @db.Decimal(10, 2)
  /// Horas pagadas al primer multiplicador (por ley, las primeras 9).
  doubleHours   Decimal @default(0) @db.Decimal(10, 2)
  /// Horas pagadas al segundo multiplicador (a partir de la 10a).
  tripleHours   Decimal @default(0) @db.Decimal(10, 2)

  /// Tarifa base por hora usada en el cálculo (se congela al aprobar).
  hourlyRate Decimal? @db.Decimal(10, 2)
  /// Importe total del tiempo extra (se congela al aprobar).
  amount     Decimal? @db.Decimal(12, 2)

  status OvertimeStatus @default(PENDIENTE)

  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User   @relation("OvertimeWorker", fields: [userId], references: [id], onDelete: Cascade)
  branch     Branch @relation(fields: [branchId], references: [id])
  reviewedBy User?  @relation("OvertimeReviewedBy", fields: [reviewedById], references: [id])

  @@unique([userId, branchId, weekStart])
  @@index([weekStart])
  @@index([status])
  @@index([userId])
  @@index([branchId])
}

enum OvertimeStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

/// Bonos y deducciones manuales de nómina (propinas repartidas,
/// préstamos, faltas de caja, premios, etc). Se capturan por semana
/// y se suman/restan al pago estimado de esa semana.
model PayrollAdjustment {
  id        String   @id @default(cuid())
  userId    String
  /// Lunes de la semana a la que corresponde el ajuste (mismo grano
  /// que OvertimeRecord.weekStart).
  weekStart DateTime

  type    PayrollAdjustmentType
  concept String
  amount  Decimal               @db.Decimal(10, 2)
  notes   String?

  createdById String
  createdAt   DateTime @default(now())

  user      User @relation("PayrollAdjustmentOwner", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User @relation("PayrollAdjustmentCreatedBy", fields: [createdById], references: [id])

  @@index([userId, weekStart])
  @@index([weekStart])
}

enum PayrollAdjustmentType {
  BONO
  DEDUCCION
}

/// *
///  * "El horario programa, el reloj checador demuestra y la nómina
///  * paga." Mientras un periodo está en BORRADOR (o no existe fila
///  * todavía — se crea perezosamente, igual que ScheduleWeek), la
///  * tabla y el expediente de Nómina se calculan EN VIVO desde
///  * TimeClockEntry/ScheduledShift/PayrollAdjustment. Al enviarlo a
///  * revisión, esos números se congelan en PayrollEntry: aunque
///  * después alguien corrija una checada vieja, la nómina ya
///  * decidida no cambia sola.
model PayrollPeriod {
  id        String   @id @default(cuid())
  /// Lunes de la semana (mismo grano que OvertimeRecord/PayrollAdjustment).
  weekStart DateTime @unique
  weekEnd   DateTime

  status PayrollPeriodStatus @default(BORRADOR)

  submittedById String?
  submittedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  paidById      String?
  paidAt        DateTime?
  rejectedNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submittedBy          User?                        @relation("PayrollPeriodSubmittedBy", fields: [submittedById], references: [id])
  approvedBy           User?                        @relation("PayrollPeriodApprovedBy", fields: [approvedById], references: [id])
  paidBy               User?                        @relation("PayrollPeriodPaidBy", fields: [paidById], references: [id])
  entries              PayrollEntry[]
  workforceLines       PayrollLine[]
  workforceAdjustments WorkforcePayrollAdjustment[] @relation("WorkforcePayrollAdjustmentAppliedPeriod")

  @@index([status])
}

enum PayrollPeriodStatus {
  BORRADOR
  REVISION
  APROBADA
  PAGADA
}

/// Snapshot congelado del pago de un empleado dentro de un periodo ya
/// enviado a revisión. `hoursByDay` y `daysSnapshot` guardan la misma
/// forma que devuelven en vivo `getPayrollWeekTable` /
/// `getEmployeePayrollDetail`, para que abrir una semana ya cerrada
/// no dependa de que los datos de origen sigan intactos.
model PayrollEntry {
  id       String @id @default(cuid())
  periodId String
  userId   String

  hourlyRate       Decimal? @db.Decimal(10, 2)
  regularHours     Decimal  @db.Decimal(10, 2)
  overtimeHours    Decimal  @db.Decimal(10, 2)
  totalHours       Decimal  @db.Decimal(10, 2)
  basePay          Decimal  @db.Decimal(12, 2)
  overtimePay      Decimal  @db.Decimal(12, 2)
  adjustmentsTotal Decimal  @default(0) @db.Decimal(12, 2)
  totalPay         Decimal  @db.Decimal(12, 2)

  hoursByDay          Json
  daysSnapshot        Json
  adjustmentsSnapshot Json @default("[]")

  createdAt DateTime @default(now())

  period PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user   User          @relation("PayrollEntryOwner", fields: [userId], references: [id])

  @@unique([periodId, userId])
  @@index([userId])
}

/// Justificación de una incidencia del expediente (llegada tarde,
/// turno no trabajado, etc.) para un día específico. Es independiente
/// de si la semana ya se congeló en PayrollEntry o no: justificar es
/// una nota de documentación, no cambia el pago.
model PayrollIncidentJustification {
  id     String   @id @default(cuid())
  userId String
  /// Día calendario (medianoche UTC, mismo formato que ScheduledShift.date).
  date   DateTime
  notes  String?

  justifiedById String
  justifiedAt   DateTime @default(now())

  user        User @relation("PayrollIncidentJustificationOwner", fields: [userId], references: [id], onDelete: Cascade)
  justifiedBy User @relation("PayrollIncidentJustificationBy", fields: [justifiedById], references: [id])

  @@unique([userId, date])
  @@index([userId, date])
}

/// *
///  * Ajustes de nómina configurables por el administrador. La fila
///  * global (id fijo "default", branchId null) aplica a cualquier
///  * sucursal sin una fila propia. Una sucursal puede tener su propio
///  * override (branchId único) si su tiempo extra se calcula distinto
///  * (ej. un turno de bar 24h vs. oficina).
model PayrollSettings {
  id       String  @id @default(cuid())
  branchId String? @unique

  /// Horas semanales a partir de las cuales cuenta como tiempo extra.
  weeklyHourThreshold  Decimal @default(48) @db.Decimal(5, 2)
  /// Horas extra por semana que se pagan al primer multiplicador.
  firstTierHours       Decimal @default(9) @db.Decimal(5, 2)
  /// Multiplicador de las primeras horas extra (por ley, 2x).
  firstTierMultiplier  Decimal @default(2) @db.Decimal(5, 2)
  /// Multiplicador de las horas extra restantes (por ley, 3x).
  secondTierMultiplier Decimal @default(3) @db.Decimal(5, 2)

  updatedAt DateTime @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

/**
 * ==========================================================
 * Workforce V1 foundation
 * ----------------------------------------------------------
 * Additive domain model. Legacy scheduling, clock and payroll
 * models remain the only active runtime write path in Phase 1A.
 * ==========================================================
 */

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum DataConfidence {
  KNOWN
  LEGACY_UNKNOWN
  ESTIMATED
}

enum WorkforceRateType {
  HOURLY
  DAILY
  WEEKLY
  SALARY
}

enum BranchAssignmentType {
  HOME
  ALLOWED
}

enum WorkforceAvailabilityExceptionType {
  AVAILABLE
  UNAVAILABLE
}

enum SchedulePeriodStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WorkforceShiftStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum ClockEventType {
  CLOCK_IN
  BREAK_START
  BREAK_END
  CLOCK_OUT
}

enum ClockCorrectionType {
  MODIFY_OCCURRED_TIME
  ADD_MISSING_EVENT
  VOID_EVENT
}

enum WorkforceDecisionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WorkSessionStatus {
  OPEN
  COMPLETE
  INCOMPLETE
}

enum WorkSessionOrigin {
  NATIVE_RECONSTRUCTED
  LEGACY_IMPORTED
}

enum WorkforceMigrationClassification {
  SAFE
  SAFE_WITH_UNKNOWN
  REVIEW_REQUIRED
  ARCHIVE_ONLY
  SKIPPED
}

enum WorkforceMigrationStatus {
  PENDING
  MIGRATED
  REVIEW
  SKIPPED
  FAILED
}

enum AttendanceExceptionType {
  LATE
  LATE_ARRIVAL
  EARLY_DEPARTURE
  MISSING_PUNCH
  MISSING_CLOCK_IN
  MISSING_CLOCK_OUT
  NO_SHOW
  UNSCHEDULED_WORK
  OVERTIME
  BREAK_ANOMALY
  INCOMPLETE_BREAK
  LONG_BREAK
}

enum AttendanceExceptionSeverity {
  INFO
  WARNING
  BLOCKING
  CRITICAL
}

enum AttendanceExceptionStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum TimesheetStatus {
  OPEN
  REVIEW
  APPROVED
  LOCKED
}

enum TimesheetAdjustmentType {
  ADD_PAYABLE_TIME
  REMOVE_PAYABLE_TIME
  RECLASSIFY_TIME
}

model Employee {
  id             String   @id @default(cuid())
  userId         String?  @unique
  employeeNumber String?  @unique
  /// Human-readable identity as supplied by its authoritative source.
  /// Legacy names remain unsplit; native flows should also capture name parts.
  displayName    String?
  firstName      String?
  lastName       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  employments Employment[]

  @@index([active])
}

model Employment {
  id                String           @id @default(cuid())
  employeeId        String
  status            EmploymentStatus @default(ACTIVE)
  startedAt         DateTime?
  endedAt           DateTime?
  terminationReason String?
  dataConfidence    DataConfidence   @default(KNOWN)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  employee               Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payRates               PayRate[]
  branchAssignments      BranchAssignment[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  shifts                 Shift[]
  shiftRevisions         ShiftRevision[]
  clockEvents            ClockEvent[]
  clockCorrections       ClockCorrection[]
  workSessions           WorkSession[]
  attendanceExceptions   AttendanceException[]
  timesheets             Timesheet[]
  payrollLines           PayrollLine[]

  @@index([employeeId, status])
}

model PayRate {
  id            String            @id @default(cuid())
  employmentId  String
  rateType      WorkforceRateType
  amount        Decimal           @db.Decimal(12, 2)
  /// Native rates must provide ISO-4217 currency. NULL means unknown legacy history.
  currency      String?           @db.Char(3)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Restrict)

  @@index([employmentId, effectiveFrom])
}

model BranchAssignment {
  id            String               @id @default(cuid())
  employmentId  String
  branchId      String
  type          BranchAssignmentType
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([employmentId, effectiveFrom, effectiveTo])
  @@index([branchId, effectiveFrom, effectiveTo])
}

model AvailabilityRule {
  id            String    @id @default(cuid())
  employmentId  String
  dayOfWeek     Int
  available     Boolean
  startTime     String?
  endTime       String?
  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Restrict)

  @@index([employmentId, effectiveFrom])
  @@index([employmentId, dayOfWeek])
}

model AvailabilityException {
  id           String                             @id @default(cuid())
  employmentId String
  date         DateTime                           @db.Date
  type         WorkforceAvailabilityExceptionType
  startTime    String?
  endTime      String?
  reason       String?
  createdAt    DateTime                           @default(now())
  updatedAt    DateTime                           @updatedAt

  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Restrict)

  @@unique([employmentId, date])
}

model SchedulePeriod {
  id          String               @id @default(cuid())
  branchId    String
  periodStart DateTime             @db.Date
  periodEnd   DateTime             @db.Date
  status      SchedulePeriodStatus @default(DRAFT)
  version     Int                  @default(1)
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  branch       Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy    User                  @relation("WorkforceSchedulePeriodCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  shifts       Shift[]
  publications SchedulePublication[]

  @@unique([branchId, periodStart, periodEnd])
  @@index([branchId, status])
}

model Shift {
  id                   String               @id @default(cuid())
  schedulePeriodId     String
  employmentId         String?
  branchId             String
  businessDate         DateTime             @db.Date
  startAt              DateTime
  endAt                DateTime
  expectedBreakMinutes Int                  @default(0)
  status               WorkforceShiftStatus @default(DRAFT)
  version              Int                  @default(1)
  createdById          String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  schedulePeriod       SchedulePeriod             @relation(fields: [schedulePeriodId], references: [id], onDelete: Restrict)
  employment           Employment?                @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  branch               Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy            User                       @relation("WorkforceShiftCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  revisions            ShiftRevision[]
  publicationLinks     SchedulePublicationShift[]
  workSessions         WorkSession[]
  attendanceExceptions AttendanceException[]

  @@index([branchId, startAt])
  @@index([employmentId, startAt])
  @@index([businessDate])
  @@index([schedulePeriodId])
}

model ShiftRevision {
  id                   String               @id @default(cuid())
  shiftId              String
  revisionNumber       Int
  employmentId         String?
  branchId             String
  businessDate         DateTime             @db.Date
  startAt              DateTime
  endAt                DateTime
  expectedBreakMinutes Int
  status               WorkforceShiftStatus
  reason               String
  changedById          String
  changedAt            DateTime             @default(now())

  shift            Shift                      @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  employment       Employment?                @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  branch           Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  changedBy        User                       @relation("WorkforceShiftRevisionChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  publicationLinks SchedulePublicationShift[]

  @@unique([shiftId, revisionNumber])
  @@index([employmentId, startAt])
  @@index([branchId, startAt])
}

model SchedulePublication {
  id               String   @id @default(cuid())
  schedulePeriodId String
  version          Int
  publishedById    String
  publishedAt      DateTime @default(now())

  schedulePeriod SchedulePeriod             @relation(fields: [schedulePeriodId], references: [id], onDelete: Restrict)
  publishedBy    User                       @relation("WorkforceSchedulePublicationPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  shifts         SchedulePublicationShift[]

  @@unique([schedulePeriodId, version])
}

model SchedulePublicationShift {
  id              String @id @default(cuid())
  publicationId   String
  shiftId         String
  shiftRevisionId String

  publication   SchedulePublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  shift         Shift               @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  shiftRevision ShiftRevision       @relation(fields: [shiftRevisionId], references: [id], onDelete: Restrict)

  @@unique([publicationId, shiftId])
  @@index([shiftRevisionId])
}

model StaffingRequirement {
  id            String   @id @default(cuid())
  branchId      String
  businessDate  DateTime @db.Date
  startTime     String
  endTime       String
  requiredCount Int
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User   @relation("WorkforceStaffingRequirementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([branchId, businessDate, startTime, endTime])
  @@index([branchId, businessDate])
}

model ClockEvent {
  id               String         @id @default(cuid())
  employmentId     String
  branchId         String
  type             ClockEventType
  deviceOccurredAt DateTime
  serverReceivedAt DateTime       @default(now())
  timezone         String
  source           String
  deviceId         String?
  idempotencyKey   String         @unique
  createdAt        DateTime       @default(now())

  employment       Employment              @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  branch           Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  targetedBy       ClockCorrection[]
  workSessionLinks WorkSessionClockEvent[]

  @@index([employmentId, deviceOccurredAt])
  @@index([branchId, serverReceivedAt])
}

model ClockCorrection {
  id                 String                  @id @default(cuid())
  employmentId       String
  branchId           String?
  targetClockEventId String?
  targetCorrectionId String?
  type               ClockCorrectionType
  proposedEventType  ClockEventType?
  proposedOccurredAt DateTime?
  reason             String
  status             WorkforceDecisionStatus @default(PENDING)
  requestedById      String
  requestedAt        DateTime                @default(now())
  approvedById       String?
  approvedAt         DateTime?
  rejectedById       String?
  rejectedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  employment              Employment        @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  branch                  Branch?           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  targetClockEvent        ClockEvent?       @relation(fields: [targetClockEventId], references: [id], onDelete: Restrict)
  targetCorrection        ClockCorrection?  @relation("WorkforceClockCorrectionCompensation", fields: [targetCorrectionId], references: [id], onDelete: Restrict)
  compensatingCorrections ClockCorrection[] @relation("WorkforceClockCorrectionCompensation")
  requestedBy             User              @relation("WorkforceClockCorrectionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy              User?             @relation("WorkforceClockCorrectionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy              User?             @relation("WorkforceClockCorrectionRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)

  @@index([employmentId, requestedAt])
  @@index([branchId, requestedAt])
  @@index([targetClockEventId])
  @@index([targetCorrectionId])
  @@index([status])
}

model WorkSession {
  id                    String            @id @default(cuid())
  employmentId          String
  branchId              String
  shiftId               String?
  businessDate          DateTime          @db.Date
  startedAt             DateTime?
  endedAt               DateTime?
  workedMinutes         Int               @default(0)
  /// NULL means legacy break information is unknown; 0 means known zero.
  breakMinutes          Int?
  /// Legacy imports may have no ClockEvent links because the source stored a composite row.
  origin                WorkSessionOrigin @default(NATIVE_RECONSTRUCTED)
  reconstructionVersion Int               @default(1)
  status                WorkSessionStatus
  reconstructedAt       DateTime
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  employment           Employment                 @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  branch               Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shift                Shift?                     @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  clockEventLinks      WorkSessionClockEvent[]
  attendanceExceptions AttendanceException[]
  timesheetLineLinks   TimesheetLineWorkSession[]

  @@index([employmentId, businessDate])
  @@index([branchId, businessDate])
  @@index([shiftId])
}

/// Technical migration ledger. It is not part of normal Workforce runtime behavior.
model WorkforceMigrationRecord {
  id               String                           @id @default(cuid())
  migrationVersion String
  legacyModel      String
  legacyId         String
  targetModel      String?
  targetId         String?
  classification   WorkforceMigrationClassification
  confidence       DataConfidence?
  status           WorkforceMigrationStatus         @default(PENDING)
  notes            String?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt

  @@unique([migrationVersion, legacyModel, legacyId])
  @@index([status, classification])
  @@index([targetModel, targetId])
}

model WorkSessionClockEvent {
  id            String @id @default(cuid())
  workSessionId String
  clockEventId  String
  sequence      Int

  workSession WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Restrict)
  clockEvent  ClockEvent  @relation(fields: [clockEventId], references: [id], onDelete: Restrict)

  @@unique([workSessionId, clockEventId])
  @@unique([workSessionId, sequence])
  @@index([clockEventId])
}

model AttendanceException {
  id                String                      @id @default(cuid())
  employmentId      String
  branchId          String
  businessDate      DateTime                    @db.Date
  shiftId           String?
  workSessionId     String?
  type              AttendanceExceptionType
  severity          AttendanceExceptionSeverity
  status            AttendanceExceptionStatus   @default(OPEN)
  blocking          Boolean                     @default(false)
  derivationKey     String
  fingerprint       String                      @unique
  derivationVersion Int                         @default(1)
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  actualStart       DateTime?
  actualEnd         DateTime?
  differenceMinutes Int?
  policySnapshot    Json
  detectedAt        DateTime                    @default(now())
  evaluatedAt       DateTime                    @default(now())
  resolvedById      String?
  resolvedAt        DateTime?
  resolution        String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  employment  Employment   @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shift       Shift?       @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  workSession WorkSession? @relation(fields: [workSessionId], references: [id], onDelete: Restrict)
  resolvedBy  User?        @relation("WorkforceAttendanceExceptionResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, type])
  @@index([branchId, businessDate, status])
  @@index([employmentId, detectedAt])
  @@index([derivationKey])
  @@index([shiftId])
  @@index([workSessionId])
}

model Timesheet {
  id           String          @id @default(cuid())
  employmentId String
  periodStart  DateTime        @db.Date
  periodEnd    DateTime        @db.Date
  status       TimesheetStatus @default(OPEN)
  version      Int             @default(1)
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  employment  Employment      @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  approvedBy  User?           @relation("WorkforceTimesheetApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  lines       TimesheetLine[]
  payrollLine PayrollLine?

  @@unique([employmentId, periodStart, periodEnd])
  @@index([employmentId, periodStart])
  @@index([status])
}

model TimesheetLine {
  id                    String   @id @default(cuid())
  timesheetId           String
  businessDate          DateTime @db.Date
  workedMinutes         Int      @default(0)
  adjustmentMinutes     Int      @default(0)
  regularPayableMinutes Int      @default(0)
  overtimeTier1Minutes  Int      @default(0)
  overtimeTier2Minutes  Int      @default(0)
  totalPayableMinutes   Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  timesheet        Timesheet                  @relation(fields: [timesheetId], references: [id], onDelete: Restrict)
  workSessionLinks TimesheetLineWorkSession[]
  adjustments      TimesheetAdjustment[]

  @@unique([timesheetId, businessDate])
}

model TimesheetLineWorkSession {
  id              String @id @default(cuid())
  timesheetLineId String
  workSessionId   String

  timesheetLine TimesheetLine @relation(fields: [timesheetLineId], references: [id], onDelete: Restrict)
  workSession   WorkSession   @relation(fields: [workSessionId], references: [id], onDelete: Restrict)

  @@unique([timesheetLineId, workSessionId])
  @@index([workSessionId])
}

model TimesheetAdjustment {
  id              String                  @id @default(cuid())
  timesheetLineId String
  type            TimesheetAdjustmentType
  minutes         Int
  reason          String
  status          WorkforceDecisionStatus @default(PENDING)
  createdById     String
  createdAt       DateTime                @default(now())
  approvedById    String?
  approvedAt      DateTime?

  timesheetLine TimesheetLine @relation(fields: [timesheetLineId], references: [id], onDelete: Restrict)
  createdBy     User          @relation("WorkforceTimesheetAdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy    User?         @relation("WorkforceTimesheetAdjustmentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([timesheetLineId, status])
}

model PayrollLine {
  id                      String            @id @default(cuid())
  payrollPeriodId         String
  employmentId            String
  timesheetId             String            @unique
  employeeNameSnapshot    String
  rateTypeSnapshot        WorkforceRateType
  payRateAmountSnapshot   Decimal           @db.Decimal(12, 2)
  currencySnapshot        String            @db.Char(3)
  regularMinutes          Int               @default(0)
  overtimeTier1Minutes    Int               @default(0)
  overtimeTier2Minutes    Int               @default(0)
  overtimeTier1Multiplier Decimal           @db.Decimal(5, 2)
  overtimeTier2Multiplier Decimal           @db.Decimal(5, 2)
  adjustmentAmount        Decimal           @default(0) @db.Decimal(12, 2)
  grossAmount             Decimal           @db.Decimal(12, 2)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  payrollPeriod    PayrollPeriod                @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  employment       Employment                   @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  timesheet        Timesheet                    @relation(fields: [timesheetId], references: [id], onDelete: Restrict)
  retroAdjustments WorkforcePayrollAdjustment[] @relation("WorkforcePayrollAdjustmentOriginalLine")

  @@unique([payrollPeriodId, employmentId])
}

/// Ajuste retroactivo de una línea histórica; no reemplaza PayrollAdjustment legacy.
model WorkforcePayrollAdjustment {
  id                     String                  @id @default(cuid())
  originalPayrollLineId  String
  appliedPayrollPeriodId String
  minutes                Int?
  amount                 Decimal?                @db.Decimal(12, 2)
  reason                 String
  status                 WorkforceDecisionStatus @default(PENDING)
  createdById            String
  createdAt              DateTime                @default(now())
  approvedById           String?
  approvedAt             DateTime?

  originalPayrollLine  PayrollLine   @relation("WorkforcePayrollAdjustmentOriginalLine", fields: [originalPayrollLineId], references: [id], onDelete: Restrict)
  appliedPayrollPeriod PayrollPeriod @relation("WorkforcePayrollAdjustmentAppliedPeriod", fields: [appliedPayrollPeriodId], references: [id], onDelete: Restrict)
  createdBy            User          @relation("WorkforcePayrollAdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy           User?         @relation("WorkforcePayrollAdjustmentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([originalPayrollLineId])
  @@index([appliedPayrollPeriodId, status])
}

/**
 * ==========================================================
 * Punto de Venta (POS)
 * ----------------------------------------------------------
 * Categorías > Productos > Variantes (ej. Mediano/Grande, o
 * "Único" si el producto no tiene variantes reales). Cada
 * variante puede tener su propia receta de ingredientes
 * (PosVariantIngredient), que apunta a InventoryProduct — el
 * mismo catálogo que ya usa Administración > Inventario — así
 * que vender descuenta del mismo stock por sucursal.
 * El descuento/reversión de inventario se hace creando
 * InventoryEntry con type VENTA_POS / DEVOLUCION_POS: se suman
 * igual que cualquier otra entrada en computeStockMatrix, sin
 * necesidad de tocar ese cálculo.
 * ==========================================================
 */
model PosCategory {
  id        String   @id @default(cuid())
  name      String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation("PosCategoryCreatedBy", fields: [createdById], references: [id])

  products PosProduct[]

  @@index([position])
}

model PosProduct {
  id         String      @id @default(cuid())
  categoryId String
  category   PosCategory @relation(fields: [categoryId], references: [id])

  name     String
  icon     String?
  active   Boolean @default(true)
  position Int     @default(0)

  // Marca productos sujetos a la política de límite mensual de
  // botellas por empleado (configurable en PosSettings). No aplica
  // a bebidas preparadas ni cobros normales.
  isBottleItem Boolean @default(false)

  createdById String?
  createdBy   User?   @relation("PosProductCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants PosProductVariant[]

  @@index([categoryId])
}

model PosProductVariant {
  id        String     @id @default(cuid())
  productId String
  product   PosProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  // "Único" cuando el producto no maneja variantes reales.
  name     String
  price    Float
  position Int     @default(0)
  active   Boolean @default(true)

  // Precio especial de empleado. Si es null, la venta a empleado
  // usa el descuento genérico (PosSettings.employeeDiscountPercent)
  // sobre `price`. Nunca se combinan los dos beneficios.
  employeePrice Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients PosVariantIngredient[]
  saleItems   PosSaleItem[]

  @@index([productId])
}

model PosVariantIngredient {
  id        String            @id @default(cuid())
  variantId String
  variant   PosProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  inventoryProductId String
  inventoryProduct   InventoryProduct @relation(fields: [inventoryProductId], references: [id])

  quantity Decimal @db.Decimal(12, 3)

  @@unique([variantId, inventoryProductId])
  @@index([variantId])
  @@index([inventoryProductId])
}

enum PosSaleStatus {
  COMPLETADA
  CANCELADA
}

/**
 * Distingue el TIPO de beneficio aplicado a una venta o línea:
 * un descuento normal, el precio/beneficio de empleado, o una
 * cortesía. Aunque el resultado económico pueda coincidir (p. ej.
 * un descuento del 100% y una cortesía ambos cobran $0), nunca se
 * tratan como lo mismo — la cortesía siempre queda identificada
 * explícitamente para auditoría, inventario y reportes.
 */
enum PosDiscountKind {
  DESCUENTO_NORMAL
  DESCUENTO_EMPLEADO
  CORTESIA
}

enum PosBenefitReason {
  CLIENTE_FRECUENTE
  PROMOCION
  COMPENSACION
  CONVENIO
  AUTORIZACION_GERENTE
  CUMPLEANOS
  EVENTO
  INVITADO
  OTRO
}

model PosSale {
  id       String @id @default(cuid())
  code     String @unique
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  cashCutId String
  cashCut   CashCut @relation(fields: [cashCutId], references: [id])

  soldById String
  soldBy   User   @relation("PosSaleSoldBy", fields: [soldById], references: [id])

  subtotal       Float
  discountAmount Float   @default(0)
  discountReason String?
  total          Float

  // Tipo/motivo estructurado del descuento aplicado a TODA la venta
  // (independiente de los beneficios por línea en PosSaleItem).
  discountKind       PosDiscountKind?
  discountReasonCode PosBenefitReason?

  // "Venta a empleado": el empleado beneficiado por los precios de
  // empleado aplicados en esta venta (ver PosSaleItem.beneficiaryEmployeeId
  // para el detalle por línea).
  employeeBuyerId String?
  employeeBuyer   User?   @relation("PosSaleEmployeeBuyer", fields: [employeeBuyerId], references: [id])

  // Autorización en el mismo dispositivo cuando el descuento supera
  // el límite del cajero (PosDiscountLimit).
  authorizedById String?
  authorizedBy   User?     @relation("PosSaleAuthorizedBy", fields: [authorizedById], references: [id])
  authorizedAt   DateTime?

  status PosSaleStatus @default(COMPLETADA)

  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("PosSaleCancelledBy", fields: [cancelledById], references: [id])
  cancelReason  String?

  createdAt DateTime @default(now())

  items    PosSaleItem[]
  payments PosSalePayment[]

  @@index([branchId])
  @@index([cashCutId])
  @@index([soldById])
  @@index([status])
  @@index([createdAt])
  @@index([employeeBuyerId])
  @@index([discountKind])
}

model PosSaleItem {
  id     String  @id @default(cuid())
  saleId String
  sale   PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  variantId String?
  variant   PosProductVariant? @relation(fields: [variantId], references: [id])

  // Copia del nombre/precio al momento de la venta, para que el
  // recibo y el historial no cambien si el catálogo cambia después.
  name      String
  unitPrice Float
  quantity  Int
  lineTotal Float

  // Cobro personalizado con el teclado (sin producto de catálogo).
  isCustom    Boolean @default(false)
  description String?

  // Beneficio aplicado a esta línea específica (descuento por
  // producto, precio de empleado, o cortesía). Null = línea normal
  // sin beneficio.
  discountKind       PosDiscountKind?
  discountReason     PosBenefitReason?
  discountReasonNote String?

  // Snapshot del precio de catálogo antes de aplicar el beneficio,
  // para poder calcular su valor económico aunque el precio cambie
  // después. benefitAmount = (originalUnitPrice - unitPrice) × quantity.
  originalUnitPrice Float?
  benefitAmount     Float?

  beneficiaryEmployeeId String?
  beneficiaryEmployee   User?   @relation("PosSaleItemBeneficiary", fields: [beneficiaryEmployeeId], references: [id])

  authorizedById String?
  authorizedBy   User?   @relation("PosSaleItemAuthorizedBy", fields: [authorizedById], references: [id])

  @@index([saleId])
  @@index([variantId])
  @@index([discountKind])
  @@index([beneficiaryEmployeeId])
}

model PosSalePayment {
  id     String  @id @default(cuid())
  saleId String
  sale   PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  method PaymentMethod
  amount Float

  @@index([saleId])
}

// Descuento máximo (%) que puede aplicar cada rol sin necesitar
// autorización de un superior. Si el rol no tiene fila, se asume
// sin límite (solo debería pasar con ADMIN).
model PosDiscountLimit {
  id         String   @id @default(cuid())
  role       UserRole @unique
  maxPercent Float
  updatedAt  DateTime @updatedAt

  updatedById String?
  updatedBy   User?   @relation("PosDiscountLimitUpdatedBy", fields: [updatedById], references: [id])
}

enum PosDiscountRuleMode {
  DISCOUNT
  BLOCK
}

model PosDiscountRule {
  id        String              @id @default(cuid())
  name      String
  mode      PosDiscountRuleMode @default(DISCOUNT)
  percent   Float?
  active    Boolean             @default(true)
  startDate DateTime?
  endDate   DateTime?
  branches  Branch[]

  createdById String
  createdBy   User     @relation("PosDiscountRuleCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("PosDiscountRuleUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, mode])
  @@index([startDate, endDate])
}

// Configuración global del Punto de Venta editable desde
// Administración. Fila única (id fijo) — mismo patrón que
// PayrollSettings.
model PosSettings {
  id                         String   @id @default("default")
  employeeDiscountPercent    Float    @default(50)
  employeeBottleMonthlyLimit Int      @default(2)
  updatedAt                  DateTime @updatedAt

  updatedById String?
  updatedBy   User?   @relation("PosSettingsUpdatedBy", fields: [updatedById], references: [id])
}

/**
 * Reglas de notificaciones push configurables desde Personal.
 * Un solo cron (GitHub Action, cada hora) llama a
 * /api/push/check-rules, que recorre las reglas activas y solo
 * evalúa las que ya cumplieron su propia frecuencia
 * (lastCheckedAt + checkFrequencyMinutes) — así cada regla puede
 * tener su propio "cuándo" sin necesitar un cron distinto.
 */
enum NotificationTriggerType {
  STOCK_BAJO
  LICOR_CADUCIDAD
  RECONTEO_PENDIENTE
  CORTE_DIFERENCIA
  PROCESO_ATRASADO
}

model NotificationRule {
  id          String                  @id @default(cuid())
  name        String
  triggerType NotificationTriggerType
  active      Boolean                 @default(true)

  // Destinatarios: roles que reciben esta notificación.
  recipientRoles UserRole[]

  // Cada cuánto se vuelve a evaluar esta regla (minutos).
  checkFrequencyMinutes Int @default(60)

  // Parámetros propios de cada tipo de disparador, ej. para
  // LICOR_CADUCIDAD: { "daysBeforeExpiration": 7 }; para
  // CORTE_DIFERENCIA: { "minDifference": 10 }.
  thresholdConfig Json?

  lastCheckedAt DateTime?
  lastSentAt    DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([triggerType])
}

/**
 * ============================================================
 * Productos conseguidos DURANTE el evento
 * ------------------------------------------------------------
 * No toca ServiceEventItem ni los paquetes originales: es una
 * fuente paralela de existencia para el mismo evento.
 * El inventario NO se guarda como saldo en ninguna tabla; se
 * calcula desde InventoryEntry (ver lib/.../stock.ts). Por eso
 * un envio desde sucursal genera un InventoryEntry negativo
 * (SALIDA_EVENTO) al mandarlo y uno positivo (REGRESO_EVENTO)
 * al regresarlo, y aqui solo se guarda la referencia.
 * Una compra externa NO genera InventoryEntry: nunca salio de
 * una sucursal, solo suma existencia al evento y costo.
 * ============================================================
 */
model EventAddedProduct {
  id      String @id @default(cuid())
  eventId String

  /// Nulo solo cuando es un producto temporal aun sin catalogar.
  productId String?

  /// Datos del producto temporal. Requieren autorizacion de GERENTE/ADMIN.
  temporaryName     String?
  temporaryCategory String?

  sourceType     EventAddedSourceType
  /// Obligatorio cuando sourceType es ENVIO_SUCURSAL o ENVIO_ALMACEN.
  sourceBranchId String?

  /// Cantidad en unidad de manejo (ej. 4 botellas).
  quantityOriginal   Decimal                @db.Decimal(12, 3)
  handlingUnit       InventoryHandlingUnit?
  contentPerUnit     Decimal?               @db.Decimal(12, 3)
  contentUnit        InventoryContentUnit?
  /// Equivalencia interna (ml, g o piezas). Los calculos usan esta.
  normalizedQuantity Decimal                @db.Decimal(14, 3)

  /// Costo. Se valida en el servidor, nunca se confia en el navegador.
  unitCost  Decimal? @db.Decimal(12, 4)
  totalCost Decimal? @db.Decimal(12, 2)

  /// Regreso. consumedQuantity NO se guarda: es quantityOriginal - returnedQuantity.
  returnedQuantity     Decimal  @default(0) @db.Decimal(12, 3)
  returnedOpenQuantity Decimal? @db.Decimal(12, 3)
  /// Sucursal a la que se devolvio, cuando aplica.
  returnBranchId       String?

  supplier  String?
  reference String?
  notes     String?

  status        EventAddedStatus @default(ACTIVO)
  cancelReason  String?
  cancelledById String?
  cancelledAt   DateTime?

  addedById String
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Movimiento de salida generado si vino de una sucursal o almacen.
  movementId       String?
  /// Movimiento de regreso, cuando ya se devolvio.
  returnMovementId String?

  event        ServiceEvent      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  product      InventoryProduct? @relation(fields: [productId], references: [id])
  sourceBranch Branch?           @relation("EventAddedSourceBranch", fields: [sourceBranchId], references: [id])
  returnBranch Branch?           @relation("EventAddedReturnBranch", fields: [returnBranchId], references: [id])
  addedBy      User              @relation("EventAddedBy", fields: [addedById], references: [id])
  cancelledBy  User?             @relation("EventAddedCancelledBy", fields: [cancelledById], references: [id])

  logs EventAddedProductLog[]

  @@index([eventId])
  @@index([productId])
  @@index([status])
  @@index([sourceBranchId])
}

/// Bitacora de correcciones. Nada se borra fisicamente.
model EventAddedProductLog {
  id             String   @id @default(cuid())
  addedProductId String
  field          String
  oldValue       String?
  newValue       String?
  reason         String?
  changedById    String
  changedAt      DateTime @default(now())

  addedProduct EventAddedProduct @relation(fields: [addedProductId], references: [id], onDelete: Cascade)
  changedBy    User              @relation("EventAddedLogBy", fields: [changedById], references: [id])

  @@index([addedProductId])
}

enum EventAddedSourceType {
  COMPRA_EVENTO
  ENVIO_SUCURSAL
  ENVIO_ALMACEN
  PRESTAMO
  OTRO
}

enum EventAddedStatus {
  ACTIVO
  CANCELADO
}
