enum PackageItemCalculationType {
  FIXED
  PER_GUEST
  PER_GUEST_BLOCK
  MANUAL
}

model ServiceEvent {
  id             String             @id @default(cuid())
  code           String             @unique
  packageId      String?
  equipmentKitId String?
  clientName     String
  clientPhone    String?
  location       String
  eventDate      DateTime
  guestCount     Int
  saleAmount     Decimal?           @db.Decimal(12, 2)
  status         ServiceEventStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Se marca cuando el inventario cargado a este evento ya se
  // descontó del inventario de una sucursal (al abrir un corte de
  // caja eligiendo este evento). Evita descontarlo dos veces.
  stockDeductedAt       DateTime?
  checkoutConfirmedAt   DateTime?
  checkoutConfirmedById String?
  returnConfirmedAt     DateTime?
  returnConfirmedById   String?

  package       EventPackage?       @relation(fields: [packageId], references: [id])
  equipmentKit  EquipmentKit?       @relation(fields: [equipmentKitId], references: [id])
  items         ServiceEventItem[]
  recounts      EventRecount[]
  cashCuts      CashCut[]
  addedProducts EventAddedProduct[]
}

model ServiceEventItem {
  id        String @id @default(cuid())
  eventId   String
  productId String

  productName          String
  unit                 String
  itemType             InventoryItemType
  unitCost             Decimal?               @db.Decimal(12, 4)
  handlingUnit         InventoryHandlingUnit?
  contentPerUnit       Decimal?               @db.Decimal(12, 3)
  contentUnit          InventoryContentUnit?
  returnedOpenQuantity Decimal?               @db.Decimal(12, 3)
  checkoutStatus       String                 @default("PENDIENTE")
  returnStatus         String                 @default("PENDIENTE")
  checkoutNotes        String?
  returnNotes          String?

  plannedQuantity  Decimal  @db.Decimal(12, 3)
  sentQuantity     Decimal? @db.Decimal(12, 3)
  returnedQuantity Decimal? @db.Decimal(12, 3)
  damagedQuantity  Decimal  @default(0) @db.Decimal(12, 3)
  lostQuantity     Decimal  @default(0) @db.Decimal(12, 3)

  checkedOut Boolean @default(false)
  checkedIn  Boolean @default(false)
  isCustom   Boolean @default(false)
  notes      String?
  sortOrder  Int     @default(0)

  event   ServiceEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  product InventoryProduct @relation(fields: [productId], references: [id])

  recountEntries EventRecountItem[]
}

/**
 * Reconteo rápido durante un evento de varios días. Cada día del
 * evento se cuenta el stock que queda contra lo que salió
 * originalmente (ServiceEventItem.sentQuantity) para saber qué hay
 * que resurtir. Se guarda un EventRecount por día para tener
 * historial completo del evento.
 */
model EventRecount {
  id          String             @id @default(cuid())
  eventId     String
  dayNumber   Int
  countDate   DateTime           @default(now())
  status      EventRecountStatus @default(PENDIENTE)
  fulfilledAt DateTime?
  notes       String?
  createdAt   DateTime           @default(now())

  event ServiceEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items EventRecountItem[]

  @@unique([eventId, dayNumber])
  @@index([eventId])
}

enum EventRecountStatus {
  PENDIENTE
  SURTIDO
}

model EventRecountItem {
  id              String  @id @default(cuid())
  recountId       String
  eventItemId     String
  countedQuantity Decimal @db.Decimal(12, 3)
  missingQuantity Decimal @db.Decimal(12, 3)

  recount   EventRecount     @relation(fields: [recountId], references: [id], onDelete: Cascade)
  eventItem ServiceEventItem @relation(fields: [eventItemId], references: [id], onDelete: Cascade)

  @@unique([recountId, eventItemId])
  @@index([recountId])
  @@index([eventItemId])
}

enum ServiceEventStatus {
  DRAFT
  PREPARING
  READY
  IN_PROGRESS
  RETURN_PENDING
  COMPLETED
  CANCELLED
}

model EquipmentKit {
