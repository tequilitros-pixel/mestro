+        const businessDate = new Date(
+          periodStart.getTime() + block.dayOfWeek * 86_400_000,
+        );
+        const { startAt, endAt } = shiftInstants({
+          businessDate,
+          startTime: block.startTime!,
+          endTime: block.endTime!,
