# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
error.txt

# local databases and backups
*.db
*.db-*
*.sqlite
*.sqlite3

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# iOS (Xcode / Swift Package Manager)
/ios/App/Pods
/ios/App/App/public
/ios/App/build
/ios/App/DerivedData
/ios/App/*.xcworkspace
/ios/**/xcuserdata
/ios/App/App/capacitor.config.json

# Android (Gradle)
/android/local.properties
/android/.gradle
/android/app/build
/android/build
/android/captures
/android/app/src/main/assets/public
/android/app/src/main/assets/capacitor.config.json
.claude/settings.local.json
_pgtest_tmp.mjs
